{
  "name": "ifcopenshell-gui",
  "version": "0.2.0",
  "description": "GUI components and workspace layout. Install ifcopenshell-gui. Import from ifcopenshell/gui and ifcopenshell/layout.",
  "type": "module",
  "main": "./src/gui/index.js",
  "module": "./src/gui/index.js",
  "style": "./styles/gui.css",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "dist",
    "styles",
    "types/index.d.ts",
    "vendor/fonts",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "types": "./types/index.d.ts",
  "exports": {
    "./gui": {
      "types": "./types/index.d.ts",
      "import": "./src/gui/index.js",
      "default": "./src/gui/index.js"
    },
    "./layout": {
      "types": "./types/index.d.ts",
      "import": "./src/layout/index.js",
      "default": "./src/layout/index.js"
    },
    "./vendor/fonts/material-symbols-outlined.css": "./vendor/fonts/material-symbols-outlined.css",
    "./styles/gui.css": "./styles/gui.css",
    "./styles/layout.css": "./styles/layout.css",
    "./styles/peers.css": "./styles/peers.css",
    "./styles/core.css": "./styles/core.css",
    "./styles/icons.css": "./styles/icons.css",
    "./styles/tokens.css": "./styles/tokens.css",
    "./styles/rules.css": "./styles/rules.css",
    "./styles/components.css": "./styles/components.css",
    "./styles/structure.css": "./styles/structure.css",
    "./styles/app-host.css": "./styles/app-host.css",
    "./styles/workspace.css": "./styles/workspace.css",
    "./styles/components/spinner.css": "./styles/components/spinner.css",
    "./styles/components/nodes.css": "./styles/components/nodes.css",
    "./styles/components/hud.css": "./styles/components/hud.css",
    "./styles/components/pie-menu.css": "./styles/components/pie-menu.css",
    "./styles/components/markdown.css": "./styles/components/markdown.css",
    "./styles/components/shell.css": "./styles/components/shell.css",
    "./styles/components/scheduling.css": "./styles/components/scheduling.css",
    "./styles/components/ag-grid-custom.css": "./styles/components/ag-grid-custom.css",
    "./styles/themes/dark.css": "./styles/themes/dark.css",
    "./styles/themes/light.css": "./styles/themes/light.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:source-check": "node --input-type=module -e \"import './src/gui/index.js'; import './src/layout/index.js'\"",
    "examples": "npm run build && npx --yes serve docs -p 5173",
    "build:catalog": "node ./scripts/generate-min-catalog.mjs",
    "docs:index": "node ./scripts/generate-docs.mjs",
    "docs:api": "typedoc && node ./scripts/enhance-typedoc.mjs",
    "docs": "npm run docs:index && npm run docs:api && npm run build:catalog",
    "check:docs": "npm run docs && git diff --exit-code docs/generated docs/ai",
    "check:entrypoints": "node ./scripts/check-entrypoints.mjs",
    "check:package-contents": "node ./scripts/check-package-contents.mjs"
  },
  "peerDependencies": {
    "@highlightjs/cdn-assets": "11.11.1",
    "ag-grid-community": "35.2.1",
    "chart.js": "4.4.7",
    "jsgantt-improved": "2.8.10",
    "showdown": "2.1.0"
  },
  "peerDependenciesMeta": {
    "@highlightjs/cdn-assets": { "optional": true },
    "ag-grid-community": { "optional": true },
    "chart.js": { "optional": true },
    "jsgantt-improved": { "optional": true },
    "showdown": { "optional": true }
  },
  "keywords": [
    "ui",
    "dom",
    "components",
    "ifc",
    "ifcopenshell",
    "ifcopenshell-gui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "@highlightjs/cdn-assets": "11.11.1",
    "ag-grid-community": "35.2.1",
    "chart.js": "4.4.7",
    "esbuild": "^0.25.0",
    "jsgantt-improved": "2.8.10",
    "showdown": "2.1.0",
    "typedoc": "^0.28.5"
  }
}
